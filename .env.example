# Copy to .env and fill in. .env is ignored by Git and is never copied into the Docker image
# (it is only visible inside the container through the /workspace bind mount).
#
# Required only by the pgd4k-single-group use case (EDB images and charts).
# Get the token from your EDB account: https://www.enterprisedb.com/accounts/profile
EDB_SUBSCRIPTION_TOKEN=replace-with-your-token

# Optional. Host address the Playground Web UI (8080) and terminal (7681) are published on.
#   127.0.0.1 (default)  this machine only      0.0.0.0  all interfaces (localhost + LAN)      a host IPv4  that interface only
# Apply with ./playground start. WARNING: anyone who can reach it gets a root terminal and the AI Builder (no authentication).
# PLAYGROUND_BIND_ADDRESS=127.0.0.1
