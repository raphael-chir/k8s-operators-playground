#!/usr/bin/env bash
# CNPG Operator Playground: the single command-line interface (replaces GNU Make).
#
# Two execution contexts, detected automatically:
#   host       lifecycle commands (doctor, install, start, stop, restart, status, uninstall, purge, version)
#              work through Docker Compose; infra/usecase commands are routed into the running container.
#   container  infra and usecase commands run the engine scripts directly (they need Bash 4+, available there).
# The host-side code is Bash 3.2 compatible (macOS default): no mapfile/readarray, no associative arrays, no set -u.
#
# Exit codes: 0 success | 1 failure (failed check, failed command, invalid argument value)
#             2 usage error (unknown command/option) | 3 the Playground container is not running
#             Engine scripts keep their own exit codes (e.g. usecase list: 2 when Docker/Kind is unreachable).
set -o pipefail

# --- paths: relative to this file (symlinks followed), whatever the current directory ----------------------
SOURCE="${BASH_SOURCE[0]}"
while [ -h "${SOURCE}" ]; do
  DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  case "${SOURCE}" in /*) ;; *) SOURCE="${DIR}/${SOURCE}" ;; esac
done
ROOT="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
VERSION=""
[ -r "${ROOT}/VERSION" ] && read -r VERSION < "${ROOT}/VERSION"
VERSION="${VERSION:-unknown}"

PROJECT="cnpg-operator-playground"          # compose.yaml `name:`: owner label of the Compose resources
CONTAINER="${PLAYGROUND_CONTAINER:-cnpg-playground}"   # compose.yaml container_name
WEB_PORT=8080
TTYD_PORT=7681
URL="http://localhost:${WEB_PORT}"
BIND_ADDRESS="127.0.0.1"                 # PLAYGROUND_BIND_ADDRESS (environment, else .env): see resolve_bind
PREFIX="${CLUSTER_PREFIX:-cnpg-lab}"
KIND_LABEL="io.x-k8s.kind.cluster"
K3D_LABEL="k3d.cluster"                  # k3d marks every container (nodes, load balancer) of a cluster with this label

# --- output ------------------------------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
  C_OK=""; C_WARN=""; C_ERR=""; C_DIM=""; C_OFF=""
fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s[OK]%s   %s\n' "${C_OK}" "${C_OFF}" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "${C_WARN}" "${C_OFF}" "$*"; }
bad()  { printf '%s[FAIL]%s %s\n' "${C_ERR}" "${C_OFF}" "$*"; }
err()  { printf '%sError:%s %s\n' "${C_ERR}" "${C_OFF}" "$*" >&2; }
info() { printf '[INFO] %s\n' "$*"; }
hint() { printf '       %s%s%s\n' "${C_DIM}" "$*" "${C_OFF}"; }
banner() { say "CNPG Operator Playground v${VERSION}"; }

in_container() {
  case "${PLAYGROUND_CONTEXT:-}" in container) return 0 ;; host) return 1 ;; esac   # explicit override (tests)
  [ -f /.dockerenv ] && [ "${ROOT}" = "/workspace" ]
}

usage() {
  cat <<EOF
CNPG Operator Playground v${VERSION}
Usage:
  ./playground <command> [options]

Lifecycle (run on the host):
  doctor              Check prerequisites (read-only)
  install             Build and prepare the Playground
  start               Start the Playground
  stop                Stop the Playground (clusters keep running)
  restart             Restart the Playground [--yes]
  status              Show the Playground status
  uninstall           Remove the Playground containers and image [--yes]
  purge               Remove the Playground and its managed resources [--dry-run] [--yes]

Infrastructure (routed into the running Playground):
  infra up CLUSTER... [--workers N]   Create Kind cluster(s)
  infra platform-up CLUSTER...        Install Prometheus/Grafana and MinIO on cluster(s)
  infra down CLUSTER...               Delete the named cluster(s)
  infra info [CLUSTER...]             Display node status and Grafana/MinIO URLs
  infra status [CLUSTER...]           Display the nodes of the clusters

Use cases (routed into the running Playground):
  usecase list                 List the use cases
  usecase start NAME           Start a use case (create its clusters, monitoring and MinIO; no PostgreSQL operator).
                               provider external: import the context from your kubeconfig and connect (nothing is created)
  usecase stop NAME [--force]  Stop a use case (delete its clusters; --force skips the confirmation).
                               provider external: only detaches, the cluster is never touched
  usecase status NAME          Show the use case's clusters, platform services and scenarios

AI Builder (optional container with the Claude Code CLI, API protected by a token):
  ai-builder start    Build if needed and start the AI Builder container on 127.0.0.1
  ai-builder stop     Stop only the AI Builder container
  ai-builder status   Show the container, its address, health and whether a Claude login exists
  ai-builder login    Sign in to Claude inside the container (interactive, browser URL)
  ai-builder logout   Sign out (removes the login stored in the claude-auth volume)
  ai-builder host start|stop|status   Previous host-mode service (temporary fallback; uses the host's claude)

Other:
  version             Display the version
  help                Display this help

Web UI: ${URL}
EOF
}

# =============================================================================================================
# Host helpers
# =============================================================================================================
have() { command -v "$1" >/dev/null 2>&1; }
# PLAYGROUND_HOST_KUBECONFIG: the host kubeconfig file (first entry of KUBECONFIG, else ~/.kube/config), mounted read-only in the container
# for external use cases. Left unset when the file does not exist (compose then mounts /dev/null: never a directory created on the host).
# PLAYGROUND_BIND_ADDRESS: host address the Web UI (8080) and terminal (7681) ports are published on. Environment first, then .env
# (read as text, never sourced), default 127.0.0.1. Strict IPv4 or it is refused before any Docker command. Exported so that compose
# (which also reads .env) can never disagree with the value checked here. 0.0.0.0 is probed through 127.0.0.1.
resolve_bind() {
  local v="${PLAYGROUND_BIND_ADDRESS-}" o
  if [ -z "${v}" ] && [ -f "${ROOT}/.env" ]; then
    v="$(grep -E '^[[:space:]]*(export[[:space:]]+)?PLAYGROUND_BIND_ADDRESS=' "${ROOT}/.env" | tail -n 1 | cut -d= -f2-)"
    v="$(printf '%s' "${v}" | sed -e 's/[[:space:]]*#.*$//' -e "s/^[[:space:]\"']*//" -e "s/[[:space:]\"']*\$//")"
  fi
  v="${v:-127.0.0.1}"
  if ! [[ "${v}" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
    err "Invalid PLAYGROUND_BIND_ADDRESS '${v}': expected an IPv4 address such as 127.0.0.1, 192.168.1.91 or 0.0.0.0."; return 2
  fi
  for o in "${BASH_REMATCH[@]:1}"; do
    [ "${#o}" -le 1 ] || [ "${o#0}" = "${o}" ] || { err "Invalid PLAYGROUND_BIND_ADDRESS '${v}': no leading zeros."; return 2; }
    [ "$((10#${o}))" -le 255 ] || { err "Invalid PLAYGROUND_BIND_ADDRESS '${v}': each part must be 0-255."; return 2; }
  done
  BIND_ADDRESS="${v}"; export PLAYGROUND_BIND_ADDRESS="${v}"
  case "${v}" in
    127.0.0.1) URL="http://localhost:${WEB_PORT}" ;;
    0.0.0.0)   URL="http://localhost:${WEB_PORT}"
               [ -n "${BIND_WARNED-}" ] || warn "PLAYGROUND_BIND_ADDRESS 0.0.0.0: every network interface can reach the Playground terminal and the AI Builder. Prefer your LAN address."; BIND_WARNED=1 ;;
    *)         URL="http://${v}:${WEB_PORT}" ;;
  esac
}
# Best-effort LAN IPv4 of this host, for display only (never blocks startup, never proves reachability): global-scope addresses,
# without loopback, link-local and container/VM/tunnel interfaces; a private address (192.168/16, 10/8, 172.16/12) is preferred.
lan_ip() {
  local out ip
  if have ip; then
    out="$(ip -o -4 addr show scope global 2>/dev/null | awk '$2 !~ /^(docker|br-|veth|virbr|vmnet|vboxnet|cni|flannel|cali|tun|tap|tailscale|zt|utun|kube|lo)/ {split($4,a,"/"); print a[1]}')"
  elif have ifconfig; then
    out="$(ifconfig 2>/dev/null | awk '/^[a-z0-9]+:/ {i=$1; sub(":","",i)} $1=="inet" && i !~ /^(lo|docker|br-|veth|vmnet|vboxnet|utun|bridge|awdl|llw|tun|tap|gif|stf|anpi|ap)/ {print $2}')"
  else
    return 0
  fi
  ip="$(printf '%s\n' "${out}" | grep -E '^(192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.)' | head -n 1)"
  [ -n "${ip}" ] || ip="$(printf '%s\n' "${out}" | grep -Ev '^(127\.|169\.254\.|$)' | head -n 1)"
  printf '%s' "${ip}"
}
# Access URLs consistent with the binding. LAN lines are only a hint: reachability depends on the host firewall and network.
print_urls() {
  case "${BIND_ADDRESS}" in
    127.0.0.1) say "Local: http://127.0.0.1:${WEB_PORT}" ;;
    0.0.0.0)   local ip; ip="$(lan_ip)"
               say "Local: http://127.0.0.1:${WEB_PORT}"
               if [ -n "${ip}" ]; then say "LAN:   http://${ip}:${WEB_PORT}   (detected address; not verified)"
               else say "LAN:   http://<HOST_LAN_IP>:${WEB_PORT}   (address not detected)"; fi ;;
    *)         say "Bound to: http://${BIND_ADDRESS}:${WEB_PORT}" ;;
  esac
}
probe_host() { [ "${BIND_ADDRESS}" = "0.0.0.0" ] && echo 127.0.0.1 || echo "${BIND_ADDRESS}"; }

dc() {
  resolve_bind || return $?
  local kc="${KUBECONFIG%%:*}"
  [ -n "${kc}" ] || kc="${HOME}/.kube/config"
  if [ -f "${kc}" ]; then export PLAYGROUND_HOST_KUBECONFIG="${kc}"; else unset PLAYGROUND_HOST_KUBECONFIG; fi
  docker compose --project-directory "${ROOT}" -f "${ROOT}/compose.yaml" "$@"
}

need_docker() {
  have docker || { err "Docker is not installed (or not on PATH). Run ./playground doctor."; return 1; }
  docker info >/dev/null 2>&1 || { err "The Docker daemon is not reachable. Start Docker Desktop / the Docker service. Run ./playground doctor."; return 1; }
}
container_running() { [ "$(docker inspect -f '{{.State.Running}}' "${CONTAINER}" 2>/dev/null)" = "true" ]; }
container_exists()  { docker inspect "${CONTAINER}" >/dev/null 2>&1; }

# In use only when something answers on 127.0.0.1:<port> AND the port cannot be bound: a bare successful connect is not proof of
# a listener (a stale forwarder or a network filter can complete the handshake while nothing is bound). Without perl: connect only.
port_in_use() {
  ( exec 3<>"/dev/tcp/127.0.0.1/$1" ) 2>/dev/null || return 1
  have perl || return 0
  ! perl -MIO::Socket::INET -e 'exit(IO::Socket::INET->new(Listen => 1, LocalAddr => "127.0.0.1", LocalPort => $ARGV[0], Proto => "tcp") ? 0 : 1)' "$1" 2>/dev/null
}
# True when the Playground container itself publishes that port.
port_is_ours() { container_running && [ -n "$(docker port "${CONTAINER}" "$1/tcp" 2>/dev/null)" ]; }

# GET <url> succeeds with HTTP 2xx (curl when present, plain bash otherwise).
http_ok() {
  if have curl; then curl -fsS -m 3 -o /dev/null "$1" 2>/dev/null; return; fi
  local rest="${1#http://}" hostport path host port
  hostport="${rest%%/*}"; path="/${rest#*/}"; host="${hostport%%:*}"; port="${hostport##*:}"
  ( exec 3<>"/dev/tcp/${host}/${port}" && printf 'GET %s HTTP/1.0\r\nHost: %s\r\n\r\n' "${path}" "${host}" >&3 && head -n 1 <&3 | grep -q ' 2[0-9][0-9] ' ) 2>/dev/null
}
wait_web() {   # PLAYGROUND_WAIT_TIMEOUT (seconds, default 60) bounds the wait for the Web UI
  local i max="${PLAYGROUND_WAIT_TIMEOUT:-60}"
  for ((i = 0; i < max; i++)); do
    if http_ok "http://$(probe_host):${WEB_PORT}/api/meta"; then return 0; fi
    sleep 1
  done
  return 1
}

confirm() {   # confirm "question" -> 0 yes; refuses (1) without a terminal
  local answer
  if [ ! -t 0 ]; then err "Confirmation required and no terminal available: re-run with --yes."; return 1; fi
  printf '%s [y/N] ' "$1"; read -r answer
  case "${answer}" in y|Y|yes|YES|Yes) return 0 ;; *) say "Cancelled."; return 1 ;; esac
}

# Kind and k3d clusters that belong to the playground: the provider's own container label AND the playground naming pattern
# <prefix>-<usecase>-<n>. One "<cluster> <state>" line per node container.
owned_nodes() {
  { docker ps -a --filter "label=${KIND_LABEL}" --format "{{.Label \"${KIND_LABEL}\"}} {{.State}}"
    docker ps -a --filter "label=${K3D_LABEL}" --format "{{.Label \"${K3D_LABEL}\"}} {{.State}}"; } 2>/dev/null |
    grep -E "^${PREFIX}-[a-z0-9]+(-[a-z0-9]+)*-[0-9]+ " | sort
}
owned_clusters() { owned_nodes | awk '{print $1}' | sort -u; }

# =============================================================================================================
# doctor
# =============================================================================================================
cmd_doctor() {
  local fails=0 warns=0 os="" arch="" ver major info ncpu mem gib
  banner; say "Prerequisites"; say
  if in_container; then err "doctor checks the host: run it outside the Playground container."; return 2; fi

  # 1. operating system
  case "$(uname -s)" in
    Darwin) os="macOS $(sw_vers -productVersion 2>/dev/null)"; ok "Operating system: ${os}" ;;
    Linux)
      if grep -qi microsoft /proc/version 2>/dev/null; then
        if uname -r | grep -qi 'microsoft-standard\|wsl2'; then
          ok "Operating system: Windows (WSL2)"
          case "${ROOT}" in
            /mnt/*) warn "The repository is on the Windows filesystem (${ROOT}): builds and file access are slow."
                    hint "Move it into the WSL2 Linux filesystem, e.g. ~/cnpg-operator-playground"; warns=$((warns + 1)) ;;
            *) ok "Repository is on the WSL2 Linux filesystem" ;;
          esac
        else
          bad "WSL1 detected: Docker Desktop requires WSL2."; hint "Run: wsl --set-version <distro> 2"; fails=$((fails + 1))
        fi
      else
        os="$(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-Linux}")"; ok "Operating system: ${os}"
      fi ;;
    *) bad "Unsupported operating system: $(uname -s)"; hint "Supported: macOS, Ubuntu Linux, Windows 11 with WSL2."; fails=$((fails + 1)) ;;
  esac

  # 2. architecture
  case "$(uname -m)" in
    arm64|aarch64) arch="arm64"; ok "Architecture: arm64" ;;
    x86_64|amd64)  arch="amd64"; ok "Architecture: amd64" ;;
    *) bad "Unsupported architecture: $(uname -m)"; hint "Supported: amd64, arm64."; fails=$((fails + 1)) ;;
  esac

  # 3-6. Docker
  if have docker; then
    ok "Docker CLI: $(docker --version 2>/dev/null | sed 's/Docker version //; s/,.*//')"
    ver="$(docker compose version --short 2>/dev/null)"; ver="${ver#v}"; major="${ver%%.*}"
    if [ -n "${ver}" ] && [ "${major}" -ge 2 ] 2>/dev/null; then ok "Docker Compose v2 (${ver})"
    else
      bad "Docker Compose v2 not found (the 'docker compose' plugin)."
      hint "Install the Compose plugin: https://docs.docker.com/compose/install/"; fails=$((fails + 1))
    fi
    if info="$(docker info --format '{{.NCPU}} {{.MemTotal}}' 2>/dev/null)"; then
      ok "Docker daemon connection"
      ncpu="${info%% *}"; mem="${info##* }"
      gib=$(( (mem + 512 * 1024 * 1024) / 1024 / 1024 / 1024 ))
      if [ "${gib}" -ge 12 ]; then ok "Docker memory: ${gib} GB"
      elif [ "${gib}" -ge 8 ]; then
        ok "Docker memory: ${gib} GB"; hint "cnpg-distributed-topology (two clusters) is more comfortable with 12 GB."
      else
        warn "Docker memory: ${gib} GB (8 GB or more recommended for one use case, 12 GB for two clusters)"
        hint "Docker Desktop: Settings > Resources > Memory."; warns=$((warns + 1))
      fi
      if [ "${ncpu}" -ge 4 ] 2>/dev/null; then ok "Docker CPUs: ${ncpu}"
      else warn "Docker CPUs: ${ncpu} (4 or more recommended)"; hint "Docker Desktop: Settings > Resources > CPUs."; warns=$((warns + 1)); fi
    else
      bad "Cannot connect to the Docker daemon."
      if [ "$(uname -s)" = "Darwin" ]; then hint "Start Docker Desktop and wait until it reports 'running'."
      elif grep -qi microsoft /proc/version 2>/dev/null; then hint "Start Docker Desktop on Windows and enable WSL integration for this distro (Settings > Resources > WSL integration)."
      else hint "Start the service (sudo systemctl start docker) and make sure your user may use it (sudo usermod -aG docker \$USER, then log in again)."; fi
      fails=$((fails + 1))
    fi
  else
    bad "Docker is not installed (or not on PATH)."
    if grep -qi microsoft /proc/version 2>/dev/null; then hint "Install Docker Desktop for Windows and enable WSL integration for this distro: https://docs.docker.com/desktop/wsl/"
    elif [ "$(uname -s)" = "Darwin" ]; then hint "Install Docker Desktop: https://docs.docker.com/desktop/setup/install/mac-install/"
    else hint "Install Docker Engine and the Compose plugin: https://docs.docker.com/engine/install/ubuntu/"; fi
    fails=$((fails + 1))
  fi

  # 7. Docker socket (mounted into the Playground container)
  if [ -S /var/run/docker.sock ]; then
    if [ -r /var/run/docker.sock ] && [ -w /var/run/docker.sock ]; then ok "Docker socket (/var/run/docker.sock)"
    else bad "Docker socket exists but is not accessible to your user."; hint "Add your user to the docker group, then log in again."; fails=$((fails + 1)); fi
  elif [ "$(uname -s)" = "Darwin" ]; then
    warn "/var/run/docker.sock not found on the host."
    hint "Docker Desktop still maps it into the VM; if the Playground cannot reach Docker, enable 'Allow the default Docker socket to be used' in Docker Desktop > Settings > Advanced."; warns=$((warns + 1))
  else
    bad "Docker socket /var/run/docker.sock not found."; hint "The Playground mounts it to create the Kind clusters."; fails=$((fails + 1))
  fi

  # 8. ports
  local p
  for p in "${WEB_PORT}" "${TTYD_PORT}"; do
    if port_in_use "${p}"; then
      if port_is_ours "${p}"; then ok "Port ${p} in use by this Playground"
      else bad "Port ${p} is already in use by another process."; hint "Find the owner with: lsof -nP -iTCP:${p} -sTCP:LISTEN (add sudo for other users' processes), then stop it."; fails=$((fails + 1)); fi
    else ok "Port ${p} available"; fi
  done

  # 9. git (only needed to fetch updates)
  if have git; then ok "Git: $(git --version | sed 's/git version //')"; else warn "Git not found (only needed to update the repository)."; warns=$((warns + 1)); fi

  # 10. OpenShift Local (CRC): detection only (optional, never blocking, never started or queried beyond its version)
  if have crc; then
    ver="$(crc version 2>/dev/null | sed -n 's/^CRC version:[[:space:]]*//p' | head -1)"; ver="${ver%%+*}"
    info "OpenShift Local (CRC): installed${ver:+ (${ver})}"
  else
    info "OpenShift Local (CRC): not installed"
  fi

  # 11. k3d: optional second internal provider, provided by the Playground image (never needed on the host, never blocking)
  if container_running && docker exec "${CONTAINER}" k3d version >/dev/null 2>&1; then info "k3d (provider.name k3d): available in the Playground image"
  else info "k3d (provider.name k3d): not in the running Playground image; optional, rebuild it with ./playground install to use it"; fi

  say
  if [ "${fails}" -gt 0 ]; then say "${fails} blocking problem(s). Fix them and run ./playground doctor again."; return 1; fi
  if [ "${warns}" -gt 0 ]; then say "Environment ready, with ${warns} warning(s)."; else say "Environment ready."; fi
  return 0
}

# =============================================================================================================
# install / start / stop / restart / status
# =============================================================================================================
cmd_install() {
  banner; say
  cmd_doctor || { err "Prerequisites are not met; nothing was changed."; return 1; }
  say
  dc config -q || { err "compose.yaml is not valid."; return 1; }
  ok "Docker Compose configuration is valid"
  say "Building the Playground image (this can take a few minutes the first time)..."
  dc build || { err "The image build failed."; return 1; }
  ok "Playground image built"
  say
  say "Installed. No cluster and no use case was created."
  say "Next: ./playground start"
}

# Host-side CPU/RAM sampler for the resource bar (engine/host-metrics.sh): the container cannot see the real host. One instance (pid file),
# started with the Playground, stopped with it; it also exits by itself when the container is not running.
HOST_METRICS_PID="${ROOT}/.host-metrics.pid"
host_metrics_stop() {
  local pid; pid="$(cat "${HOST_METRICS_PID}" 2>/dev/null)"
  [ -z "${pid}" ] || ps -p "${pid}" -o command= 2>/dev/null | grep -q host-metrics.sh && kill "${pid}" 2>/dev/null
  rm -f "${HOST_METRICS_PID}"
  return 0
}
host_metrics_start() {
  host_metrics_stop
  [ -z "${PLAYGROUND_NO_HOST_METRICS:-}" ] || return 0   # tests use a fake docker: no background process
  nohup bash "${ROOT}/engine/host-metrics.sh" "${CONTAINER}" >/dev/null 2>&1 < /dev/null &
  echo $! > "${HOST_METRICS_PID}"
}

cmd_start() {
  banner
  need_docker || return 1
  if in_container; then err "start runs on the host."; return 2; fi
  dc up -d || { err "docker compose up failed."; return 1; }
  ok "Playground started"
  host_metrics_start
  if wait_web; then
    ok "Web UI ready"
    print_urls
  else
    err "The Web UI did not answer in time. Check: docker logs ${CONTAINER}"
    return 1
  fi
}

cmd_stop() {
  banner
  need_docker || return 1
  dc --profile ai-builder stop || { err "docker compose stop failed."; return 1; }
  ok "Playground stopped"
  host_metrics_stop
  local n
  n="$(owned_clusters | wc -l | tr -d ' ')"
  say "Kind and k3d clusters are independent Docker containers and keep running (${n} found)."
  say "Stop a use case before stopping the Playground to delete its clusters, or run ./playground purge."
  say "Open terminals (one Bash each) end with the container; the clusters and volumes are kept."
}

cmd_restart() {
  local yes=0 sessions=0
  while [ $# -gt 0 ]; do case "$1" in --yes|-y) yes=1 ;; *) err "Unknown option for restart: $1"; return 2 ;; esac; shift; done
  banner
  need_docker || return 1
  if container_running; then
    sessions="$(docker exec "${CONTAINER}" sh -c 'pgrep -P "$(pgrep -x ttyd | head -1)"' 2>/dev/null | wc -l | tr -d ' ')"
    if [ "${sessions}" -gt 0 ] && [ "${yes}" -eq 0 ]; then
      warn "${sessions} open terminal(s) will be closed by the restart (their shell and running command end); open WebSocket connections are dropped."
      confirm "Restart the Playground?" || return 1
    fi
  fi
  resolve_bind || return $?
  if container_exists && ! docker port "${CONTAINER}" 8080/tcp 2>/dev/null | grep -q "^${BIND_ADDRESS}:"; then
    # The published address changed: restart keeps the old port bindings, so the container is recreated (volumes and clusters untouched).
    say "PLAYGROUND_BIND_ADDRESS changed (${BIND_ADDRESS}): recreating the Playground container."
    dc up -d --force-recreate || { err "docker compose up failed."; return 1; }
  else
    dc restart || { err "docker compose restart failed."; return 1; }
  fi
  ok "Playground restarted (Kind clusters untouched)"
  host_metrics_start
  if wait_web; then ok "Web UI ready"; print_urls; else err "The Web UI did not answer in time."; return 1; fi
}

cmd_status() {
  resolve_bind || return $?
  local state web="not running" docker_state clusters nodes
  banner; say
  say "Version:        ${VERSION}"
  if ! have docker; then say "Docker:         not installed"; return 1; fi
  if docker info >/dev/null 2>&1; then docker_state="available"; else docker_state="NOT reachable"; fi
  say "Docker:         ${docker_state}"
  if [ "${docker_state}" != "available" ]; then say "Playground:     unknown (Docker unreachable)"; return 1; fi
  state="$(docker inspect -f '{{.State.Status}}' "${CONTAINER}" 2>/dev/null)"
  say "Playground:     ${state:-not installed}"
  if [ "${state}" = "running" ]; then
    if http_ok "http://$(probe_host):${WEB_PORT}/api/meta"; then web="${URL} (ready)"; else web="${URL} (not answering)"; fi
  fi
  say "Web UI:         ${web}"
  nodes="$(owned_nodes)"
  if [ -z "${nodes}" ]; then
    say "Clusters:       none (Kind or k3d)"
  else
    say "Clusters (Kind or k3d):"
    printf '%s\n' "${nodes}" | awk '{n[$1]++; if ($2=="running") r[$1]++} END {for (c in n) printf "  %-48s %d/%d nodes running\n", c, r[c], n[c]}' | sort
    say "Use cases:      $(owned_clusters | sed -E "s/^${PREFIX}-(.*)-[0-9]+$/\1/" | sort -u | tr '\n' ' ')"
  fi
}

# =============================================================================================================
# uninstall / purge
# =============================================================================================================
cmd_uninstall() {
  local yes=0
  while [ $# -gt 0 ]; do case "$1" in --yes|-y) yes=1 ;; *) err "Unknown option for uninstall: $1"; return 2 ;; esac; shift; done
  banner; say
  need_docker || return 1
  say "This removes the Playground container, its network and its built image."
  say "It keeps: Kind clusters and their data, the 'kube' and 'history' volumes (kubeconfig, shell history), your files."
  [ "${yes}" -eq 1 ] || confirm "Uninstall the Playground?" || return 1
  dc --profile ai-builder down --rmi local || { err "docker compose down failed."; return 1; }
  ok "Playground containers and image removed"
  host_metrics_stop
  say
  say "Still present:"
  say "  - Kind and k3d clusters: $(owned_clusters | tr '\n' ' ')"
  say "  - Docker volumes: $(docker volume ls -q --filter "label=com.docker.compose.project=${PROJECT}" | tr '\n' ' ')"
  say "  - The repository at ${ROOT}"
  say "Run ./playground purge --dry-run to see what a full cleanup would remove."
}

cmd_purge() {
  local yes=0 dry=0 clusters vols name ids failures=0
  while [ $# -gt 0 ]; do case "$1" in --yes|-y) yes=1 ;; --dry-run|-n) dry=1 ;; *) err "Unknown option for purge: $1"; return 2 ;; esac; shift; done
  banner; say
  need_docker || return 1
  clusters="$(owned_clusters)"
  vols="$(docker volume ls -q --filter "label=com.docker.compose.project=${PROJECT}")"
  say "Resources owned by the Playground (established by the Kind or k3d cluster label + the '${PREFIX}-<usecase>-<n>' name,"
  say "and by the Docker Compose project label '${PROJECT}'):"
  say
  say "  Kind and k3d clusters (all their nodes and the data inside):"
  if [ -n "${clusters}" ]; then printf '%s\n' "${clusters}" | sed 's/^/    - /'; else say "    (none)"; fi
  say "  Playground container: $(container_exists && echo "${CONTAINER}" || echo '(none)') (plus its Compose network and image)"
  say "  Docker volumes (kubeconfig, terminal state, shell history):"
  if [ -n "${vols}" ]; then printf '%s\n' "${vols}" | sed 's/^/    - /'; else say "    (none)"; fi
  say
  say "Never touched: other containers and clusters, the shared 'kind' and 'k3d-playground' networks, unrelated volumes and images,"
  say "the repository and your files. No 'docker system prune' or 'docker volume prune' is ever run."
  say
  if [ "${dry}" -eq 1 ]; then say "Dry run: nothing was deleted."; return 0; fi
  if [ "${yes}" -eq 0 ]; then
    if [ ! -t 0 ]; then err "Confirmation required and no terminal available: re-run with --yes."; return 1; fi
    printf "This is irreversible. Type 'purge' to continue: "; local answer; read -r answer
    [ "${answer}" = "purge" ] || { say "Cancelled."; return 1; }
  fi
  for name in ${clusters}; do
    # The name already matched ^<prefix>-<usecase>-<n> and carries a Kind or k3d label (owned_clusters): only that cluster's containers go.
    ids="$(docker ps -a -q --filter "label=${KIND_LABEL}=${name}"; docker ps -a -q --filter "label=${K3D_LABEL}=${name}")"
    if [ -n "${ids}" ] && docker rm -f -v ${ids} >/dev/null 2>&1; then
      docker volume rm $(docker volume ls -q --filter "label=${K3D_LABEL}=${name}") >/dev/null 2>&1 || true   # k3d's image volume of that cluster
      ok "Deleted cluster ${name}"
    else bad "Could not delete cluster ${name}"; failures=$((failures + 1)); fi
  done
  host_metrics_stop
  if dc --profile ai-builder down -v --rmi local >/dev/null 2>&1; then ok "Removed the Playground container, network, volumes and image"
  else bad "docker compose down -v failed (some Playground resources may remain)"; failures=$((failures + 1)); fi
  say
  if [ "${failures}" -gt 0 ]; then err "${failures} resource(s) could not be removed; they were left untouched."; return 1; fi
  say "Purge complete. The repository is untouched; ./playground install starts over."
}

# =============================================================================================================
# Container-side commands (infra, usecase): run the existing engine scripts, no logic duplicated here
# =============================================================================================================
require_names() {   # require_names <what> <names...>
  local what="$1"; shift
  if [ $# -eq 0 ]; then err "${what} requires at least one cluster name, e.g. ${PREFIX}-mytest-1 (several names allowed)."; return 1; fi
}

# A plain directory name under usecases/, with the script present.
run_usecase_script() {   # run_usecase_script <name> <start|stop|status>: the engine runs the lifecycle declared in usecase.yaml
  local name="$1" action="$2"
  case "${name}" in ""|*[!a-z0-9-]*) err "A use case name is required (a directory under usecases/)."; return 1 ;; esac
  if [ ! -f "${ROOT}/usecases/${name}/usecase.yaml" ]; then err "Unknown use case '${name}': usecases/${name}/usecase.yaml not found."; return 1; fi
  ( cd "${ROOT}" && unset KUBECONFIG && exec bash engine/usecase-run.sh "${action}" "${name}" )
}

container_infra() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift
  local workers="" names=() run="${ROOT}/engine/infra-run.sh"
  unset KUBECONFIG    # lifecycle commands always use the shared kubeconfig, like the Web UI backend
  case "${sub}" in
    up)
      while [ $# -gt 0 ]; do
        case "$1" in
          --workers|-w) [ -n "${2:-}" ] || { err "--workers needs a number."; return 2; }; workers="$2"; shift ;;
          -*) err "Unknown option for infra up: $1"; return 2 ;;
          *) names+=("$1") ;;
        esac; shift
      done
      require_names "infra up" ${names[@]+"${names[@]}"} || return 1
      [ -z "${workers}" ] || export WORKERS="${workers}"
      bash "${run}" up "${names[@]}" ;;
    platform-up) require_names "infra platform-up" "$@" || return 1; bash "${run}" platform-up "$@" ;;
    down)        require_names "infra down" "$@" || return 1; bash "${run}" down "$@" ;;
    info)        bash "${run}" info "$@" ;;
    status)      bash "${run}" status "$@" ;;
    ""|-h|--help|help) say "Usage: ./playground infra {up|platform-up|down|info|status} [CLUSTER...]"; [ -n "${sub}" ] ;;
    *) err "Unknown infra command '${sub}'. Try: up, platform-up, down, info, status."; return 2 ;;
  esac
}

container_usecase() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift
  local name="" force=0
  case "${sub}" in
    list)
      unset KUBECONFIG
      local out rc line n c state
      out="$(bash "${ROOT}/engine/usecase-list.sh")"; rc=$?
      [ "${rc}" -eq 0 ] || return "${rc}"
      printf '%-30s %-8s %s\n' NAME STATUS CLUSTERS
      while IFS=$'\t' read -r n c; do
        [ -n "${n}" ] || continue
        state=stopped; [ "${c}" -gt 0 ] && state=running
        printf '%-30s %-8s %s\n' "${n}" "${state}" "${c}"
      done <<< "${out}" ;;
    start|stop|status)
      while [ $# -gt 0 ]; do
        case "$1" in
          --force|--yes|-y) [ "${sub}" = stop ] || { err "Option $1 only applies to 'usecase stop'."; return 2; }; force=1 ;;
          -*) err "Unknown option for usecase ${sub}: $1"; return 2 ;;
          *) [ -z "${name}" ] || { err "Only one use case name is accepted."; return 2; }; name="$1" ;;
        esac; shift
      done
      [ "${force}" -eq 0 ] || export FORCE=1
      case "${sub}" in
        start)  run_usecase_script "${name}" start ;;
        stop)   run_usecase_script "${name}" stop ;;
        status) run_usecase_script "${name}" status ;;
      esac ;;
    ""|-h|--help|help) say "Usage: ./playground usecase {list|start NAME|stop NAME [--force]|status NAME}"; [ -n "${sub}" ] ;;
    *) err "Unknown usecase command '${sub}'. Try: list, start, stop, status."; return 2 ;;
  esac
}

# A value of the provider section of usecases/<name>/usecase.yaml (type | context); empty when absent.
manifest_provider_value() {   # <name> <key>
  awk -v k="$2" '/^provider:[ ]*$/ { s = 1; next } /^[^ \t#]/ { s = 0 } s && $1 == k ":" { v = $2; gsub(/["\047]/, "", v); print v; exit }' "${ROOT}/usecases/$1/usecase.yaml" 2>/dev/null
}

# External provider, host side of `usecase start`: copy ONLY the configured context (with its credentials, resolved through KUBECONFIG
# like kubectl does) from the host kubeconfig into the container, which checks it (engine/providers/external/import.sh). The host
# kubeconfig is only read; nothing is printed.
external_import() {   # <name>
  local name="$1" ctx tool=""
  [ "$(manifest_provider_value "${name}" type)" = external ] || return 0
  ctx="$(manifest_provider_value "${name}" context)"
  [ -n "${ctx}" ] || { err "usecases/${name}/usecase.yaml: provider type external needs provider.context"; return 1; }
  need_docker || return 1
  container_running || { err "The Playground is not running. Start it first: ./playground start"; return 3; }
  if have kubectl; then tool=kubectl; elif have oc; then tool=oc; fi
  [ -n "${tool}" ] || { err "kubectl or oc is needed on the host to read the context '${ctx}' from your kubeconfig."; return 1; }
  "${tool}" config view --minify --flatten --raw --context "${ctx}" 2>/dev/null | grep -q . ||
    { err "Context '${ctx}' not found in your kubeconfig (KUBECONFIG=${KUBECONFIG:-~/.kube/config})."; return 1; }
  "${tool}" config view --minify --flatten --raw --context "${ctx}" 2>/dev/null |
    docker exec -i "${CONTAINER}" bash /workspace/engine/providers/external/import.sh "${name}" || return 1
}

# Host side: run the same command inside the running container (interactive only when attached to a terminal).
route_to_container() {
  need_docker || return 1
  if ! container_running; then
    err "The Playground is not running. Start it first: ./playground start"
    return 3
  fi
  # `docker exec` (not `docker compose exec`, which prints an extra "exit status N" line on failures).
  local flags=(-i)
  if [ -t 0 ] && [ -t 1 ]; then flags=(-i -t); fi
  docker exec "${flags[@]}" -w /workspace "${CONTAINER}" /workspace/playground "$@"
}

# =============================================================================================================
# AI Builder. Container mode (default): compose service "ai-builder" with Claude Code inside.
# Host mode (`ai-builder host ...`, temporary fallback): ai-builder/server.py on the host, using the host's claude.
# =============================================================================================================
AIB_PORT="${AI_BUILDER_PORT:-8099}"
AIB_DIR="${AI_BUILDER_STATE_DIR:-${ROOT}/.ai-builder}"   # tests point it at a temporary directory
AIB_PID="${AIB_DIR}/server.pid"
AIB_LOG="${AIB_DIR}/server.log"
AIB_URL="http://127.0.0.1:${AIB_PORT}"

aib_pid() {   # prints the PID only when it is alive AND is our server (a stale PID file never kills a stranger)
  local pid
  [ -r "${AIB_PID}" ] || return 1
  read -r pid < "${AIB_PID}" || return 1
  case "${pid}" in ''|*[!0-9]*) return 1 ;; esac
  ps -p "${pid}" -o command= 2>/dev/null | grep -q "ai-builder/server.py" || return 1
  echo "${pid}"
}

cmd_ai_builder_host() {
  local sub="${1:-}" pid i
  case "${sub}" in
    start)
      banner
      have python3 || { err "python3 is required (the AI Builder uses only its standard library)."; return 1; }
      have "${AI_BUILDER_CLAUDE:-claude}" || { err "Claude Code CLI not found. Install it and sign in on this machine first (https://docs.claude.com/en/docs/claude-code)."; return 1; }
      if pid="$(aib_pid)"; then ok "AI Builder already running (PID ${pid}) at ${AIB_URL}"; return 0; fi
      if port_in_use "${AIB_PORT}"; then err "Port ${AIB_PORT} is already in use by another process. Set AI_BUILDER_PORT."; return 1; fi
      mkdir -p "${AIB_DIR}"
      nohup python3 "${ROOT}/ai-builder/server.py" >> "${AIB_LOG}" 2>&1 < /dev/null &
      echo $! > "${AIB_PID}"
      for ((i = 0; i < 10; i++)); do http_ok "${AIB_URL}/health" && break; sleep 1; done
      if http_ok "${AIB_URL}/health"; then
        ok "AI Builder started"; say "Listening on ${AIB_URL} (127.0.0.1 only). Log: ${AIB_LOG}"
      else
        err "The AI Builder did not answer. See ${AIB_LOG}"; return 1
      fi ;;
    stop)
      banner
      if pid="$(aib_pid)"; then
        kill "${pid}" 2>/dev/null
        for ((i = 0; i < 10; i++)); do kill -0 "${pid}" 2>/dev/null || break; sleep 1; done
        rm -f "${AIB_PID}"
        ok "AI Builder stopped (the Playground and the clusters are untouched)"
      else
        rm -f "${AIB_PID}"; say "AI Builder is not running."
      fi ;;
    status)
      if pid="$(aib_pid)"; then
        ok "AI Builder running (PID ${pid}) at ${AIB_URL}"
        if http_ok "${AIB_URL}/health"; then ok "health: ok"; else warn "health: no answer"; return 1; fi
      else
        say "AI Builder is not running. Start it: ./playground ai-builder start"; return 1
      fi ;;
    *) err "Unknown ai-builder host command '${sub}'. Try: start, stop, status."; return 2 ;;
  esac
}

# --- container mode (default): compose service "ai-builder", profile "ai-builder" -------------------------------------
AIB_CONTAINER="cnpg-ai-builder"
AIB_TOKEN_FILE="${AI_BUILDER_TOKEN_FILE:-${ROOT}/.ai-builder-token}"
AIB_STATE="${AI_BUILDER_STATE_DIR:-${ROOT}/.ai-builder}"
# compose interpolates these (secret file, state bind mount, published port); only the compose calls see them
dca() { AI_BUILDER_TOKEN_FILE="${AIB_TOKEN_FILE}" AI_BUILDER_STATE_DIR="${AIB_STATE}" AI_BUILDER_PORT="${AIB_PORT}" dc --profile ai-builder "$@"; }
aib_running() { [ "$(docker inspect -f '{{.State.Running}}' "${AIB_CONTAINER}" 2>/dev/null)" = "true" ]; }

# The token file is created once (mode 600) and never printed. It is a compose secret: the container reads it, the agent is denied it.
aib_ensure_token() {
  [ -s "${AIB_TOKEN_FILE}" ] && return 0
  ( umask 077; od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "${AIB_TOKEN_FILE}" ) 2>/dev/null && [ -s "${AIB_TOKEN_FILE}" ] || { err "Could not create ${AIB_TOKEN_FILE}"; return 1; }
  chmod 600 "${AIB_TOKEN_FILE}"
}

# GET <path> with the bearer token passed through curl's stdin config (never on a command line, so not visible in `ps`).
aib_get() {
  have curl || { err "curl is required to query the AI Builder."; return 1; }
  [ -s "${AIB_TOKEN_FILE}" ] || return 1
  { printf 'header = "Authorization: Bearer '; tr -d '\n' < "${AIB_TOKEN_FILE}"; printf '"\n'; } | curl -fsS -m 3 -K - "${AIB_URL}$1" 2>/dev/null
}

cmd_ai_builder_container() {
  local sub="${1:-}" i body
  case "${sub}" in
    start)
      banner
      need_docker || return 1
      if aib_pid >/dev/null; then err "The host-mode AI Builder is running on port ${AIB_PORT}. Stop it first: ./playground ai-builder host stop"; return 1; fi
      if ! aib_running && port_in_use "${AIB_PORT}"; then err "Port ${AIB_PORT} is already in use by another process. Set AI_BUILDER_PORT."; return 1; fi
      mkdir -p "${AIB_STATE}" || { err "Cannot create ${AIB_STATE}"; return 1; }   # created here as you: Docker would create it as root
      aib_ensure_token || return 1
      dca up -d --build ai-builder ai-publisher || { err "docker compose up failed for ai-builder."; return 1; }   # ai-publisher: the only writer of usecases/
      for ((i = 0; i < "${AI_BUILDER_WAIT_TIMEOUT:-60}"; i++)); do aib_get /health >/dev/null && break; sleep 1; done
      if aib_get /health >/dev/null; then
        ok "AI Builder started (container ${AIB_CONTAINER})"; say "Listening on ${AIB_URL} (host loopback only). API token: ${AIB_TOKEN_FILE}"
        body="$(aib_get /health)"
        case "${body}" in *'"claude_credentials_present": true'*) ;; *) say "Not signed in to Claude yet: ./playground ai-builder login" ;; esac
      else
        err "The AI Builder did not answer. Check: docker logs ${AIB_CONTAINER}"; return 1
      fi ;;
    stop)
      banner; need_docker || return 1
      dca stop ai-builder ai-publisher || { err "docker compose stop failed for ai-builder."; return 1; }
      ok "AI Builder stopped (the Playground and the clusters are untouched; jobs, drafts and the login are kept)" ;;
    status)
      need_docker || return 1
      if ! aib_running; then say "AI Builder container is not running. Start it: ./playground ai-builder start"; return 1; fi
      ok "AI Builder container running (${AIB_CONTAINER}) at ${AIB_URL}"
      if body="$(aib_get /health)"; then
        ok "health: ok"
        case "${body}" in *'"claude_credentials_present": true'*) ok "Claude login: present" ;; *) warn "Claude login: none (./playground ai-builder login)" ;; esac
      else warn "health: no answer (or token mismatch)"; return 1; fi ;;
    login|logout)
      need_docker || return 1
      aib_running || { err "The AI Builder container is not running. Start it first: ./playground ai-builder start"; return 1; }
      [ -t 0 ] && [ -t 1 ] || { err "'${sub}' is interactive and needs a terminal."; return 1; }
      [ "${sub}" = login ] && say "Open the URL that Claude prints in your browser, sign in, then paste the code back here."
      docker exec -it "${AIB_CONTAINER}" claude auth "${sub}" ;;
    *) err "Unknown ai-builder command '${sub}'. Try: start, stop, status, login, logout, host."; return 2 ;;
  esac
}

cmd_ai_builder() {
  case "${1:-}" in
    host) shift; cmd_ai_builder_host "$@" ;;
    *) cmd_ai_builder_container "$@" ;;
  esac
}

# =============================================================================================================
# dispatch
# =============================================================================================================
main() {
  local cmd="${1:-help}"; [ $# -gt 0 ] && shift
  case "${cmd}" in
    -h|--help|help) usage; return 0 ;;
    -V|--version|version) say "CNPG Operator Playground v${VERSION}"; return 0 ;;
    doctor|install|start|stop|restart|status|uninstall|purge)
      if in_container; then err "'${cmd}' runs on the host, not inside the Playground container."; return 2; fi
      "cmd_${cmd}" "$@" ;;
    ai-builder)
      if in_container; then err "'ai-builder' runs on the host, not inside the Playground container."; return 2; fi
      cmd_ai_builder "$@" ;;
    infra|usecase)
      case "${1:-}" in ""|-h|--help|help) "container_${cmd}" "$@"; return ;; esac   # usage needs no container
      if in_container; then "container_${cmd}" "$@"
      else
        if [ "${cmd}" = usecase ] && [ "${1:-}" = start ] && [ -n "${2:-}" ]; then external_import "$2" || return $?; fi
        route_to_container "${cmd}" "$@"
      fi ;;
    *) err "Unknown command '${cmd}'."; say "Run ./playground --help" >&2; return 2 ;;
  esac
}

main "$@"
